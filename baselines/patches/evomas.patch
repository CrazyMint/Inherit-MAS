+def _meta_usage_snapshot(meta_model):
+    """Snapshot the meta-model's cumulative token usage (for a per-op cost delta)."""
+    try:
+        m = getattr(meta_model, "model", None)
+        if m is not None and hasattr(m, "get_cumulative_token_usage"):
+            return m.get_cumulative_token_usage()
+    except Exception:
+        pass
+    return None
+
+
+def _record_meta_op(meta_model, phase, before):
+    """Record one meta-model operator's LLM cost (additive; no effect on results)."""
+    try:
+        if before is None:
+            return
+        after = meta_model.model.get_cumulative_token_usage()
+        COST_LEDGER.record(
+            phase=phase, role="meta-model",
+            model_id=getattr(meta_model, "model_id", "") or "",
+            input_tokens=after.get("input_tokens", 0) - before.get("input_tokens", 0),
+            output_tokens=after.get("output_tokens", 0) - before.get("output_tokens", 0),
+        )
